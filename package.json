{
  "name": "apuntado",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "preinstall": "node scripts/check-node.mjs",
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "dev:server": "node --env-file-if-exists=.env --watch --import tsx apps/server/src/main.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "npm run build -w @apuntado/contracts && npm run build -w @apuntado/server && npm run build -w @apuntado/web",
    "typecheck": "tsc -p packages/contracts/tsconfig.json --noEmit && tsc -p apps/server/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json",
    "test": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:e2e": "node --env-file-if-exists=.env node_modules/@playwright/test/cli.js test",
    "test:load": "node --env-file-if-exists=.env --import tsx scripts/load-test.ts",
    "architecture": "node scripts/architecture.mjs",
    "preview:up": "docker compose -f compose.preview.yaml up -d --build --wait app",
    "preview:down": "docker compose -f compose.preview.yaml down",
    "test:operations": "node scripts/operations-drill.mjs",
    "release:package": "node scripts/package-release.mjs",
    "db:up": "docker compose up -d --wait db",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "start": "node --env-file-if-exists=.env apps/server/dist/main.js",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build",
    "setup": "node scripts/setup.mjs",
    "pretest": "npm run build -w @apuntado/contracts",
    "pretypecheck": "npm run build -w @apuntado/contracts",
    "pretest:e2e": "npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "node-pg-migrate": "9.0.0",
    "prettier": "3.10.1",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "glob": "14.0.6",
    "minimatch": "11.0.9"
  }
}
