NODE_ENV=development
HOST=127.0.0.1
PORT=3001
WEB_PORT=5173
DATABASE_URL=postgresql://apuntado:apuntado_local@127.0.0.1:54329/apuntado
TEST_DATABASE_URL=postgresql://apuntado:apuntado_local@127.0.0.1:54329/apuntado_test
